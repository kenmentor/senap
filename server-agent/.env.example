# Copy to .env and fill in. Server fail-softs to localhost/Mongo defaults in dev,
# but prod must set MONGODB_URI + PUBLIC_APP_URL + AGENT_API_KEY.
MONGODB_URI=mongodb://127.0.0.1:27017/senap
PORT=3001
PUBLIC_APP_URL=http://localhost:3000
# Dashboard origin(s) allowed to call the agent (comma-separated). Empty = open (dev).
ALLOWED_ORIGINS=http://localhost:3000
# If set, dashboard must send Authorization: Bearer <key> (or x-agent-key). Unset = open (dev).
AGENT_API_KEY=
# Cloudflare AI Gateway (Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WA_LOG_LEVEL=warn
# Outbound task webhooks (dashboard reacts without polling). Empty = disabled.
TASK_WEBHOOK_URL=
TASK_WEBHOOK_SECRET=
# Max bulk broadcast sends per account per day (WhatsApp anti-ban guardrail).
BROADCAST_DAILY_CAP=250

# ── How the two services talk to each other ─────────────────────────────────
# Dashboard → agent: dashboard sets AGENT_URL=<agent public URL> and
#   AGENT_API_KEY=<shared secret>. This service checks the same AGENT_API_KEY.
# Agent → dashboard: set PUBLIC_APP_URL / ALLOWED_ORIGINS to the dashboard URL
#   so CORS and link-building target the dashboard, not localhost.
# The shared AGENT_API_KEY must be IDENTICAL on both services.
MONGODB_URI=mongodb://127.0.0.1:27017/senap
PORT=3001
PUBLIC_APP_URL=http://localhost:3000
# Dashboard origin(s) allowed to call the agent (comma-separated). Empty = open (dev).
ALLOWED_ORIGINS=http://localhost:3000
# If set, dashboard must send Authorization: Bearer <key> (or x-agent-key). Unset = open (dev).
AGENT_API_KEY=
# Cloudflare AI Gateway (Workers AI) — fallback when Groq is unset/down
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Groq (OpenAI-compatible) — primary model when set. Get a key at console.groq.com.
GROQ_API_KEY=
# Override the Groq model (default: openai/gpt-oss-120b).
GROQ_MODEL=
WA_LOG_LEVEL=warn
# Outbound task webhooks (dashboard reacts without polling). Empty = disabled.
TASK_WEBHOOK_URL=
TASK_WEBHOOK_SECRET=
# Max bulk broadcast sends per account per day (WhatsApp anti-ban guardrail).
BROADCAST_DAILY_CAP=250

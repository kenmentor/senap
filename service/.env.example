# ── senap dashboard (service/) ─────────────────────────────────────────────
# Copy to .env.local for dev. In production (Render/Vercel dashboard) set every
# variable below as an environment variable — never commit real secrets.
#
# Generate a strong secret with:  openssl rand -hex 32

# REQUIRED — MongoDB connection (e.g. MongoDB Atlas). No default in prod.
MONGODB_URI=mongodb://127.0.0.1:27017/senap

# REQUIRED — signs auth cookies. Must be a long random string in prod.
AUTH_SECRET=change-me-in-prod

# Where the WhatsApp agent (server-agent) lives.
# Server-side (used by API routes). Point at your deployed agent URL.
AGENT_URL=http://localhost:3001
# Client-side fallback for the same. Must be the public agent URL in prod.
NEXT_PUBLIC_AGENT_URL=http://localhost:3001

# Must match the agent's AGENT_API_KEY exactly. Empty on both sides = open (dev only).
# In prod always set a long random value on BOTH services.
AGENT_API_KEY=
# Optional client-side key, forwarded by some routes as a fallback.
NEXT_PUBLIC_AGENT_KEY=

# Monthly reply quota shown on the home cost bar.
COST_QUOTA=1000
